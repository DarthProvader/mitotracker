    <!-- SettingsScreen.kt -->
    <string name="settings_subtitle">Every borrowed number says where it came from.</string>
    <string name="settings_panel">Panel</string>
    <string name="fact_remembered_panels">Remembered panels</string>
    <string name="settings_simulator_note">The simulator drives a panel that only exists in memory, so the app can be shown and tested without hardware in the room.</string>
    <string name="settings_reconnect_label">Reconnect when in range</string>
    <string name="settings_reconnect_explanation">A remembered panel is reached from its stored address, with no scan.</string>
    <string name="settings_keep_control_label">Keep control while the screen is off</string>
    <string name="settings_keep_control_explanation">A ten minute exposure is exactly when a phone gets locked. This keeps a notification on screen so Android does not reclaim the connection halfway through.</string>
    <string name="settings_exposure">Exposure</string>
    <string name="settings_manual_title">Mito Light\'s manual</string>
    <string name="settings_manual_note">10 to 20 minutes per area per day, an area lit once or twice, and no more than 30 minutes in total if the same area is lit twice. These are their numbers, not ours, which is why they are the defaults.</string>
    <string name="fact_daily_limit">Daily limit per area</string>
    <string name="fact_ceiling">Ceiling when lit twice</string>
    <string name="fact_warn_at">Warn at</string>
    <string name="settings_warn_at_format">%1$d %% of the limit</string>
    <string name="settings_default_countdown">Default countdown</string>
    <string name="settings_panel_accepts_note">The panel itself accepts 1 to 20 minutes.</string>
    <string name="settings_ask_area_label">Ask which area before starting</string>
    <string name="settings_ask_area_explanation">Turn this off and a run is recorded as ambient light: the panel was on, and no area is credited with the minutes.</string>
    <string name="settings_warn_near_limit_label">Warn near the limit</string>
    <string name="settings_warn_near_limit_explanation">Amber is the only colour allowed to contradict you, and only on the authority of the manual.</string>
    <string name="settings_areas_presets">Areas and presets</string>
    <string name="settings_areas_fixed_format">%1$d, fixed</string>
    <string name="fact_default_presets">Default presets</string>
    <string name="settings_areas_no_overlap_note">Areas do not overlap, which is the only reason minutes can be added up without counting the same light twice.</string>
    <string name="fact_sessions">Sessions</string>
    <string name="fact_unattributed">Unattributed</string>
    <string name="settings_seeded_note">Seeded with generated history so the statistics have something to show before a real session exists. Real sessions land in the same list.</string>
    <string name="settings_health">Health</string>
    <string name="settings_read_health_label">Read sleep and heart rate</string>
    <string name="settings_read_health_explanation">Sleep, heart rate variability and resting heart rate can be read from Health Connect and shown beside this history. Nothing is written back: Health Connect has no light therapy type, and filing sessions as workouts would inflate your exercise totals.</string>
    <string name="settings_notifications">Notifications</string>
    <string name="settings_notify_end_label">When a session ends</string>
    <string name="settings_notify_drop_label">If the link drops mid-session</string>
    <string name="settings_notify_drop_explanation">The panel keeps counting down without us, so a dropped link is not a stop.</string>
